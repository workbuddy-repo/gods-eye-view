# 复制为 .env（cp .env.example .env && chmod 600 .env）后填写。
# 本文件既供 compose 做变量替换，也整份注入容器。

# ---- 部署相关 ----

# 主机端口：容器内的 4173 映射到主机的这个端口。80 最省事（域名后不用带端口）。
GEV_PORT=80

# 你要访问它的完整域名，多个用逗号分隔。
# Vite 默认只认 localhost 和 IP，域名必须在这里登记，否则返回
# "Blocked request. This host is not allowed."
GEV_ALLOWED_HOSTS=replace-me-with-your-long-random-domain.example.com

# ---- 以下 API key 全部可选：一个都不填也能跑（ keyless Esri 影像 + OSM）----
# 说明见仓库根目录 .env.example / README。

# 浏览器端可见（会被打进前端包），务必在 Google Cloud 里做 HTTP referrer + API 限制。
# 开启 Google 逼真 3D 瓦片、地点搜索、街景。
GOOGLE_MAPS_API_KEY=

# 服务端专用，不下发到浏览器，可按服务器 IP 限制；不填则回退到上面那个 key。
GOOGLE_MAPS_SERVER_API_KEY=

# Cesium ion：Google 逼真 3D 瓦片 / 全球地形 / Bing 影像。
CESIUM_ION_TOKEN=

# Mapillary 街景图层（Street Level）。
MAPILLARY_CLIENT_TOKEN=

# 语音控制 / AI HUD 摘要。会按量计费，注意配额。
OPENAI_API_KEY=

# 航班数据：anon 匿名可用（有限流），oauth 需要下面的凭据。
OPENSKY_AUTH_MODE=anon
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
